{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "texts",
      "header": "Тексты",
      "icon": "type",
      "blocks": [
        [
          {
            "type": "textinput",
            "label": "Текст",
            "size": 2,
            "validator": { "required": true, "maxLength": 160, "minLength": 3 },
            "destination": "texts.cookieText"
          },
          {
            "type": "textinput",
            "label": "Текст кнопки",
            "size": 1,
            "validator": { "required": true, "maxLength": 25, "minLength": 2 },
            "destination": "texts.acceptLabel"
          }
        ],
        {
          "header": "Политика конфиденциальности",
          "blocks": [
            {
              "type": "privacyPolicy"
            }
          ]
        }
      ]
    },
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": {
        "type": "design",
        "validator": { "wcag": { "text": 4.5, "primary": 3 } }
      }
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "select",
            "label": "Вариант",
            "destination": "settings.variant",
            "options": [
              { "value": "text", "label": "Без иконки" },
              { "value": "cookie", "label": "С иконкой на фоне" },
              { "value": "icon-left", "label": "С иконкой слева" },
              { "value": "icon-big", "label": "С большой иконкой" }
            ]
          },
          {
            "type": "select",
            "label": "Тема",
            "destination": "settings.theme",
            "options": [
              { "value": "blue", "label": "Синяя" },
              { "value": "green", "label": "Зелёная" },
              { "value": "purple", "label": "Фиолетовая" },
              { "value": "orange", "label": "Оранжевая" }
            ]
          }
        ],
        {
          "header": "Положение",
          "blocks": [
            {
              "type": "settings.position",
              "destination": "settings.position",
              "options": [
                { "value": "top-left", "label": "Сверху слева" },
                { "value": "top-center", "label": "Сверху по центру" },
                { "value": "top-right", "label": "Сверху справа" },
                { "value": "center-left", "label": "По центру слева" },
                { "value": "center-right", "label": "По центру справа" },
                { "value": "bottom-left", "label": "Снизу слева" },
                { "value": "bottom-center", "label": "Снизу по центру" },
                { "value": "bottom-right", "label": "Снизу справа" }
              ]
            }
          ]
        },
        {
          "header": "Отступы от края",
          "headerHelp": "Отступ баннера от края экрана по горизонтали и вертикали",
          "blocks": [
            [
              {
                "type": "slider",
                "label": "По горизонтали",
                "destination": "settings.offsetX",
                "min": 0,
                "max": 100,
                "step": 4,
                "options": [
                  { "value": 0, "label": "0" },
                  { "value": 50, "label": "" },
                  { "value": 100, "label": "100" }
                ]
              },
              {
                "type": "slider",
                "label": "По вертикали",
                "destination": "settings.offsetY",
                "min": 0,
                "max": 100,
                "step": 4,
                "options": [
                  { "value": 0, "label": "0" },
                  { "value": 50, "label": "" },
                  { "value": 100, "label": "100" }
                ]
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.cloud" } ],
        [ { "type": "installation.website" } ],
        [ { "type": "installation.telegram" } ]
      ]
    }
  ]
}
