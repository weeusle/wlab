{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": {
        "type": "design",
        "validator": { "wcag": { "text": 4.5, "primary": 3 } }
      }
    },
    {
      "id": "buttons",
      "header": "Блок кнопки",
      "icon": "grid",
      "afterHeader": "Одновременно можно включить максимум 2 кнопки: мессенджер, звонок или свой текст.",
      "blocks": [
        {
          "header": "Написать в мессенджер",
          "blocks": [
            {
              "type": "toggler",
              "label": "Показывать кнопку",
              "destination": "settings.showMessenger"
            },
            {
              "type": "select",
              "label": "Мессенджер",
              "destination": "settings.messenger",
              "options": [
                { "value": "max", "label": "MAX" },
                { "value": "telegram", "label": "Telegram" },
                { "value": "whatsapp", "label": "WhatsApp" },
                { "value": "vk", "label": "ВКонтакте" }
              ]
            },
            {
              "type": "textinput",
              "label": "Текст кнопки",
              "destination": "texts.messengerText",
              "validator": { "maxLength": 30, "minLength": 2 }
            },
            {
              "type": "textinput",
              "label": "Ссылка на чат в мессенджере",
              "destination": "settings.messengerUrl",
              "validator": { "maxLength": 300 }
            }
          ]
        },
        {
          "header": "Позвонить",
          "blocks": [
            {
              "type": "toggler",
              "label": "Показывать кнопку",
              "destination": "settings.showCall"
            },
            {
              "type": "textinput",
              "label": "Номер телефона",
              "destination": "texts.phone",
              "validator": { "maxLength": 30 }
            }
          ]
        },
        {
          "header": "Свой текст",
          "blocks": [
            {
              "type": "toggler",
              "label": "Показывать кнопку",
              "destination": "settings.showCustom"
            },
            {
              "type": "textinput",
              "label": "Текст кнопки",
              "destination": "texts.customText",
              "validator": { "maxLength": 30, "minLength": 2 }
            },
            {
              "type": "textinput",
              "label": "Ссылка в кнопке",
              "destination": "settings.customUrl",
              "validator": { "maxLength": 300 }
            }
          ]
        },
        {
          "header": "Плашка над кнопкой",
          "blocks": [
            {
              "type": "toggler",
              "label": "Показывать плашку",
              "destination": "settings.showBadge"
            },
            {
              "type": "textinput",
              "label": "Текст плашки",
              "destination": "texts.badgeText",
              "validator": { "maxLength": 40 }
            }
          ]
        }
      ]
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "select",
            "label": "Положение",
            "destination": "settings.position",
            "options": [
              { "value": "top-left", "label": "Сверху слева" },
              { "value": "top-center", "label": "Сверху по центру" },
              { "value": "top-right", "label": "Сверху справа" },
              { "value": "center-left", "label": "Центр слева" },
              { "value": "center-right", "label": "Центр справа" },
              { "value": "bottom-left", "label": "Снизу слева" },
              { "value": "bottom-center", "label": "Снизу по центру" },
              { "value": "bottom-right", "label": "Снизу справа" }
            ]
          },
          {
            "type": "range",
            "label": "Скругление углов",
            "destination": "settings.borderRadius",
            "min": 0,
            "max": 100,
            "step": 1
          },
          {
            "type": "range",
            "label": "Отступ по горизонтали, px",
            "destination": "settings.offsetX",
            "min": 0,
            "max": 100,
            "step": 2
          },
          {
            "type": "range",
            "label": "Отступ по вертикали, px",
            "destination": "settings.offsetY",
            "min": 0,
            "max": 100,
            "step": 2
          }
        ]
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" },
          { "type": "triggers.timer" },
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.cloud" } ],
        [ { "type": "installation.website" } ],
        [ { "type": "installation.telegram" } ]
      ]
    }
  ]
}
