{
  "steps": [
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": { "type": "design" }
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        {
          "header": "Контент",
          "blocks": [
            {
              "type": "textinput",
              "label": "Ссылка на видео",
              "destination": "settings.videoUrl",
              "after": "Ссылка с YouTube, Vimeo, VK, RuTube или прямой файл (mp4/webm)",
              "validator": { "required": true }
            }
          ]
        },
        {
          "header": "Кнопка",
          "blocks": [
            {
              "type": "textinput",
              "label": "Текст кнопки",
              "destination": "texts.buttonText",
              "validator": { "required": true, "maxLength": 25 }
            },
            {
              "type": "textinput",
              "label": "Ссылка кнопки",
              "destination": "settings.buttonUrl",
              "after": "Куда ведёт кнопка «Оставить заявку»"
            },
            {
              "type": "slider",
              "label": "Таймер появления кнопки, сек",
              "destination": "settings.ctaDelay",
              "min": 0,
              "max": 30,
              "step": 1,
              "after": "Через сколько секунд после разворачивания появляется кнопка",
              "options": [
                { "value": 0, "label": "Сразу" },
                { "value": 5, "label": "5" },
                { "value": 30, "label": "30" }
              ]
            }
          ]
        },
        {
          "header": "Положение",
          "blocks": [
            {
              "type": "settings.sizeposition",
              "destination": "settings.layout",
              "positions": ["top-left", "top-center", "top-right", "center-left", "center-right", "bottom-left", "bottom-center", "bottom-right"],
              "features": { "showLayoutMode": false, "showWidth": false, "showOffset": true }
            }
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" },
          { "type": "triggers.timer" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [
          { "type": "installation.website" }
        ]
      ]
    }
  ]
}
