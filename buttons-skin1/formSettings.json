{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "texts",
      "header": "Тексты",
      "icon": "type",
      "blocks": [
        [
          {
            "type": "textinput",
            "label": "Текст кнопки мессенджера",
            "size": 1,
            "validator": { "required": true, "maxLength": 30, "minLength": 2 },
            "destination": "texts.messengerText"
          },
          {
            "type": "textinput",
            "label": "Текст кнопки звонка",
            "size": 1,
            "validator": { "maxLength": 30, "minLength": 2 },
            "destination": "texts.callText"
          },
          {
            "type": "textinput",
            "label": "Телефон",
            "size": 1,
            "validator": { "maxLength": 30 },
            "destination": "texts.phone"
          },
          {
            "type": "textinput",
            "label": "Бейдж",
            "size": 1,
            "validator": { "maxLength": 40 },
            "destination": "texts.badgeText"
          }
        ]
      ]
    },
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": {
        "type": "design",
        "validator": { "wcag": { "text": 4.5, "primary": 3 } }
      }
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "select",
            "label": "Мессенджер",
            "destination": "settings.messenger",
            "options": [
              { "value": "max", "label": "MAX" },
              { "value": "telegram", "label": "Telegram" },
              { "value": "whatsapp", "label": "WhatsApp" },
              { "value": "vk", "label": "ВКонтакте" },
              { "value": "message", "label": "Сообщение" },
              { "value": "audit", "label": "Аудит" }
            ]
          },
          {
            "type": "textinput",
            "label": "Ссылка на мессенджер",
            "destination": "settings.messengerUrl",
            "validator": { "maxLength": 300 }
          },
          {
            "type": "select",
            "label": "Стиль кнопки звонка",
            "destination": "settings.phoneStyle",
            "options": [
              { "value": "ghost", "label": "Контурная" },
              { "value": "soft", "label": "Мягкая" },
              { "value": "solid", "label": "Заливка" }
            ]
          }
        ],
        {
          "header": "Что показывать",
          "blocks": [
            {
              "type": "toggler",
              "label": "Кнопка мессенджера",
              "destination": "settings.showMessenger"
            },
            {
              "type": "toggler",
              "label": "Кнопка звонка",
              "destination": "settings.showPhone"
            },
            {
              "type": "toggler",
              "label": "Бейдж",
              "destination": "settings.showBadge"
            },
            {
              "type": "toggler",
              "label": "Повышенный контраст",
              "destination": "settings.a11yContrast"
            }
          ]
        },
        {
          "header": "Форма и положение",
          "blocks": [
            {
              "type": "settings.shape",
              "destination": "settings.rounding",
              "options": [
                { "value": "full", "label": "Капсула" },
                { "value": "rounded", "label": "Скруглённая" },
                { "value": "square", "label": "Прямоугольная" }
              ]
            },
            {
              "type": "select",
              "label": "Плотность",
              "destination": "settings.compact",
              "options": [
                { "value": "auto", "label": "Авто" },
                { "value": "full", "label": "Полная" },
                { "value": "labels", "label": "С подписями" },
                { "value": "icon-phone", "label": "Иконка телефона" },
                { "value": "min", "label": "Минимальная" }
              ]
            },
            {
              "type": "settings.position",
              "destination": "settings.position",
              "options": [
                { "value": "top-left", "label": "Сверху слева" },
                { "value": "top-center", "label": "Сверху по центру" },
                { "value": "top-right", "label": "Сверху справа" },
                { "value": "bottom-left", "label": "Снизу слева" },
                { "value": "bottom-center", "label": "Снизу по центру" },
                { "value": "bottom-right", "label": "Снизу справа" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.cloud" } ],
        [ { "type": "installation.website" } ],
        [ { "type": "installation.telegram" } ]
      ]
    }
  ]
}
