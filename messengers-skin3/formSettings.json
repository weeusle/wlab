{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "texts",
      "header": "Тексты",
      "icon": "type",
      "blocks": [
        [
          {
            "type": "textinput",
            "label": "Заголовок",
            "size": 2,
            "validator": { "required": true, "maxLength": 60, "minLength": 5 },
            "destination": "settings.headerText"
          },
          {
            "type": "textinput",
            "label": "Подзаголовок",
            "size": 1,
            "validator": { "maxLength": 80 },
            "destination": "settings.subtitleText"
          },
          {
            "type": "textinput",
            "label": "Телефон",
            "size": 1,
            "validator": { "maxLength": 30 },
            "destination": "settings.phone"
          }
        ]
      ]
    },
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": {
        "type": "design",
        "validator": { "wcag": { "text": 4.5, "primary": 3 } }
      }
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "select",
            "label": "Вид попапа",
            "destination": "settings.popupVariant",
            "options": [
              { "value": "qr", "label": "QR-код" },
              { "value": "list", "label": "Список" }
            ]
          },
          {
            "type": "select",
            "label": "Основной мессенджер",
            "destination": "settings.messenger",
            "options": [
              { "value": "max", "label": "MAX" },
              { "value": "telegram", "label": "Telegram" },
              { "value": "whatsapp", "label": "WhatsApp" },
              { "value": "vk", "label": "ВКонтакте" }
            ]
          },
          {
            "type": "select",
            "label": "Тема",
            "destination": "settings.theme",
            "options": [
              { "value": "light", "label": "Светлая" },
              { "value": "dark", "label": "Тёмная" }
            ]
          }
        ],
        {
          "header": "Поведение",
          "blocks": [
            {
              "type": "toggler",
              "label": "Открыт по умолчанию",
              "destination": "settings.openByDefault"
            },
            {
              "type": "toggler",
              "label": "Повышенный контраст",
              "destination": "settings.a11yContrast"
            }
          ]
        },
        {
          "header": "Положение",
          "blocks": [
            {
              "type": "select",
              "label": "Плотность",
              "destination": "settings.compact",
              "options": [
                { "value": "auto", "label": "Авто" },
                { "value": "full", "label": "Полная" },
                { "value": "labels", "label": "С подписями" },
                { "value": "icon-phone", "label": "Иконка телефона" },
                { "value": "min", "label": "Минимальная" }
              ]
            },
            {
              "type": "settings.position",
              "destination": "settings.position",
              "options": [
                { "value": "top-left", "label": "Сверху слева" },
                { "value": "top-right", "label": "Сверху справа" },
                { "value": "bottom-left", "label": "Снизу слева" },
                { "value": "bottom-right", "label": "Снизу справа" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.cloud" } ],
        [ { "type": "installation.website" } ],
        [ { "type": "installation.telegram" } ]
      ]
    }
  ]
}
