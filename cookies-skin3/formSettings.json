{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "texts",
      "header": "Тексты",
      "icon": "type",
      "blocks": [
        [
          {
            "type": "textinput",
            "label": "Основной текст",
            "size": 2,
            "validator": { "required": true, "maxLength": 160, "minLength": 10 },
            "destination": "settings.mainText"
          },
          {
            "type": "textinput",
            "label": "Текст кнопки",
            "size": 1,
            "validator": { "required": true, "maxLength": 25, "minLength": 2 },
            "destination": "settings.buttonText"
          }
        ],
        {
          "header": "Политика конфиденциальности",
          "blocks": [
            {
              "type": "privacyPolicy"
            }
          ]
        }
      ]
    },
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": {
        "type": "design",
        "validator": { "wcag": { "text": 4.5, "primary": 3 } }
      }
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "select",
            "label": "Тема",
            "destination": "settings.theme",
            "options": [
              { "value": "theme1", "label": "Тема 1" },
              { "value": "theme2", "label": "Тема 2" },
              { "value": "theme3", "label": "Тема 3" },
              { "value": "theme4", "label": "Тема 4" }
            ]
          },
          {
            "type": "select",
            "label": "Раскладка",
            "destination": "settings.layout",
            "options": [
              { "value": "floating", "label": "Плавающая" },
              { "value": "full", "label": "Во всю ширину" }
            ]
          },
          {
            "type": "select",
            "label": "Плотность",
            "destination": "settings.compact",
            "options": [
              { "value": "auto", "label": "Авто" },
              { "value": "expanded", "label": "Развёрнутая" },
              { "value": "compact", "label": "Компактная" }
            ]
          }
        ]
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.cloud" } ],
        [ { "type": "installation.website" } ],
        [ { "type": "installation.telegram" } ]
      ]
    }
  ]
}
