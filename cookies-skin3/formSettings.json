{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "texts",
      "header": "Тексты",
      "icon": "type",
      "blocks": [
        [
          {
            "type": "textinput",
            "label": "Основной текст",
            "size": 2,
            "validator": { "required": true, "maxLength": 160, "minLength": 10 },
            "destination": "settings.mainText"
          },
          {
            "type": "textinput",
            "label": "Текст кнопки",
            "size": 1,
            "validator": { "required": true, "maxLength": 25, "minLength": 2 },
            "destination": "settings.buttonText"
          }
        ],
        {
          "header": "Политика конфиденциальности",
          "blocks": [
            {
              "type": "privacyPolicy"
            }
          ]
        }
      ]
    },
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "blocks": [
        [
          {
            "type": "design.themes"
          }
        ],
        {
          "header": "Шрифт",
          "afterHeader": "выберите подходящий",
          "blocks": {
            "type": "design.fonts"
          }
        },
        [
          {
            "type": "toggler",
            "label": "Тень",
            "hint": "Показывать тень у виджета",
            "destination": "design.shadow"
          }
        ],
        [
          {
            "type": "design.hidelogo"
          }
        ]
      ]
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "select",
            "label": "Раскладка",
            "destination": "settings.layout",
            "options": [
              { "value": "floating", "label": "Плавающая" },
              { "value": "full", "label": "Во всю ширину" }
            ]
          },
          {
            "type": "select",
            "label": "Плотность",
            "destination": "settings.compact",
            "options": [
              { "value": "auto", "label": "Авто" },
              { "value": "expanded", "label": "Развёрнутая" },
              { "value": "compact", "label": "Компактная" }
            ]
          }
        ],
        {
          "header": "Положение",
          "headerHelp": "В раскладке «Во всю ширину» работают только верх и низ",
          "blocks": [
            {
              "type": "settings.position",
              "destination": "settings.position",
              "options": [
                { "value": "top-left", "label": "Сверху слева" },
                { "value": "top-center", "label": "Сверху по центру" },
                { "value": "top-right", "label": "Сверху справа" },
                { "value": "center-left", "label": "По центру слева" },
                { "value": "center-right", "label": "По центру справа" },
                { "value": "bottom-left", "label": "Снизу слева" },
                { "value": "bottom-center", "label": "Снизу по центру" },
                { "value": "bottom-right", "label": "Снизу справа" }
              ]
            }
          ]
        },
        {
          "header": "Отступы от края",
          "headerHelp": "Отступ баннера от края экрана по горизонтали и вертикали",
          "blocks": [
            [
              {
                "type": "slider",
                "label": "По горизонтали",
                "destination": "settings.offsetX",
                "min": 0,
                "max": 100,
                "step": 4,
                "options": [
                  { "value": 0, "label": "0" },
                  { "value": 50, "label": "" },
                  { "value": 100, "label": "100" }
                ]
              },
              {
                "type": "slider",
                "label": "По вертикали",
                "destination": "settings.offsetY",
                "min": 0,
                "max": 100,
                "step": 4,
                "options": [
                  { "value": 0, "label": "0" },
                  { "value": 50, "label": "" },
                  { "value": 100, "label": "100" }
                ]
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.cloud" } ],
        [ { "type": "installation.website" } ],
        [ { "type": "installation.telegram" } ]
      ]
    }
  ]
}
