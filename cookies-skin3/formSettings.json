{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "texts",
      "header": "Тексты",
      "icon": "type",
      "blocks": [
        [
          {
            "type": "textinput",
            "label": "Основной текст",
            "size": 2,
            "validator": { "required": true, "maxLength": 160, "minLength": 10 },
            "destination": "settings.mainText"
          },
          {
            "type": "textinput",
            "label": "Текст кнопки",
            "size": 1,
            "validator": { "required": true, "maxLength": 25, "minLength": 2 },
            "destination": "settings.buttonText"
          }
        ],
        {
          "header": "Политика конфиденциальности",
          "blocks": [
            {
              "type": "privacyPolicy"
            }
          ]
        }
      ]
    },
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "blocks": [
        [
          {
            "type": "design.themes"
          }
        ],
        {
          "header": "Шрифт",
          "afterHeader": "выберите подходящий",
          "blocks": {
            "type": "design.fonts"
          }
        },
        [
          {
            "type": "toggler",
            "label": "Тень",
            "hint": "Показывать тень у виджета",
            "destination": "design.shadow"
          }
        ],
        [
          {
            "type": "design.hidelogo"
          }
        ]
      ]
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "settings.sizeposition",
            "destination": "settings.layout",
            "features": { "showWidth": false }
          }
        ]
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.cloud" } ],
        [ { "type": "installation.website" } ],
        [ { "type": "installation.telegram" } ]
      ]
    }
  ]
}
