{
  "platforms": [
    "desktop",
    "phone"
  ],
  "steps": [
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "blocks": [
        {
          "type": "design",
          "validator": { "wcag": { "text": 4.5, "primary": 3 } }
        },
        {
          "header": "Рамка",
          "blocks": [
            {
              "type": "toggler",
              "label": "Показывать рамку",
              "destination": "settings.border"
            }
          ]
        }
      ]
    },
    {
      "id": "texts",
      "header": "Текст",
      "icon": "type",
      "blocks": [
        {
          "type": "textinput",
          "label": "Заголовок",
          "size": 1,
          "validator": { "maxLength": 60 },
          "destination": "texts.title"
        },
        {
          "type": "textinput",
          "label": "Подзаголовок",
          "size": 1,
          "validator": { "maxLength": 120 },
          "destination": "texts.subtitle"
        }
      ]
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        {
          "header": "Контент",
          "blocks": [
            {
              "type": "textinput",
              "label": "Ссылка на первое видео",
              "destination": "settings.video1",
              "validator": { "maxLength": 300 }
            },
            {
              "type": "textinput",
              "label": "Ссылка на второе видео",
              "destination": "settings.video2",
              "validator": { "maxLength": 300 }
            },
            {
              "type": "textinput",
              "label": "Ссылка на третье видео",
              "destination": "settings.video3",
              "validator": { "maxLength": 300 }
            }
          ]
        },
        {
          "header": "Воспроизведение",
          "blocks": [
            {
              "type": "toggler",
              "label": "Автозапуск видео",
              "destination": "settings.autoplay"
            },
            {
              "type": "toggler",
              "label": "Зацикливание",
              "destination": "settings.loop"
            },
            {
              "type": "toggler",
              "label": "Без звука",
              "destination": "settings.muted"
            },
            {
              "type": "toggler",
              "label": "Развернуто по умолчанию",
              "destination": "settings.openByDefault"
            }
          ]
        },
        {
          "header": "Кнопки",
          "blocks": [
            {
              "type": "toggler",
              "label": "Первая кнопка",
              "destination": "settings.button1"
            },
            {
              "type": "textinput",
              "label": "Текст кнопки",
              "destination": "settings.button1Label",
              "validator": { "maxLength": 30 }
            },
            {
              "type": "textinput",
              "label": "Ссылка в кнопке",
              "destination": "settings.button1Url",
              "validator": { "maxLength": 300 }
            },
            {
              "type": "toggler",
              "label": "Вторая кнопка",
              "destination": "settings.button2"
            },
            {
              "type": "textinput",
              "label": "Текст кнопки",
              "destination": "settings.button2Label",
              "validator": { "maxLength": 30 }
            },
            {
              "type": "textinput",
              "label": "Ссылка в кнопке",
              "destination": "settings.button2Url",
              "validator": { "maxLength": 300 }
            }
          ]
        },
        {
          "header": "Положение",
          "blocks": [
            {
              "type": "settings.sizeposition",
              "destination": "settings.layout",
              "positions": [
                "top-left",
                "top-center",
                "top-right",
                "center-left",
                "center-right",
                "bottom-left",
                "bottom-center",
                "bottom-right"
              ],
              "features": { "showWidth": false, "showOffset": true }
            }
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" }
        ],
        [
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [ { "type": "installation.website" } ]
      ]
    }
  ]
}
