{
  "steps": [
    {
      "id": "texts",
      "header": "Тексты",
      "icon": "type",
      "blocks": [
        [
          {
            "type": "textinput",
            "label": "Заголовок коллекции",
            "destination": "texts.collectionTitle",
            "validator": { "required": true, "maxLength": 40 }
          },
          {
            "type": "textinput",
            "label": "Заголовок сюжета",
            "destination": "texts.storyTitle",
            "validator": { "required": true, "maxLength": 40 }
          },
          {
            "type": "textinput",
            "label": "Описание сюжета",
            "destination": "texts.storyDescription",
            "size": 2,
            "validator": { "maxLength": 120 }
          },
          {
            "type": "textinput",
            "label": "Текст кнопки",
            "destination": "texts.buttonText",
            "validator": { "required": true, "maxLength": 30 }
          },
          {
            "type": "textinput",
            "label": "Лейбл карточки",
            "destination": "texts.cardLabel",
            "validator": { "maxLength": 20 }
          },
          {
            "type": "textinput",
            "label": "Заголовок формы",
            "destination": "texts.formTitle",
            "validator": { "maxLength": 40 }
          },
          {
            "type": "textinput",
            "label": "Плейсхолдер телефона",
            "destination": "texts.phonePlaceholder",
            "validator": { "maxLength": 30 }
          },
          {
            "type": "textinput",
            "label": "Текст кнопки отправки",
            "destination": "texts.submitText",
            "validator": { "maxLength": 20 }
          },
          {
            "type": "textinput",
            "label": "Сообщение после отправки",
            "destination": "texts.successText",
            "validator": { "maxLength": 80 }
          }
        ]
      ]
    },
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": { "type": "design" }
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        [
          {
            "type": "select",
            "label": "Режим показа",
            "destination": "settings.displayMode",
            "options": [
              { "value": "strip", "label": "Лента историй" },
              { "value": "launcher", "label": "Плавающая карточка" }
            ]
          },
          {
            "type": "toggler",
            "label": "Иконки и подписи на карточках",
            "destination": "settings.showCardMeta"
          },
          {
            "type": "toggler",
            "label": "Выцветание краёв ленты",
            "destination": "settings.edgeFade"
          },
          {
            "type": "select",
            "label": "Действие кнопки",
            "destination": "settings.cta.mode",
            "options": [
              { "value": "form", "label": "Форма с телефоном" },
              { "value": "link", "label": "Ссылка (напр. Telegram)" }
            ]
          },
          {
            "type": "textinput",
            "label": "Ссылка кнопки (для режима «Ссылка»)",
            "destination": "settings.cta.linkUrl",
            "validator": { "maxLength": 200 }
          }
        ],
        {
          "header": "Расположение",
          "blocks": [
            {
              "type": "settings.sizeposition",
              "destination": "settings.layout",
              "positions": ["top", "bottom"],
              "features": { "showWidth": false, "showOffset": true }
            }
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "triggers.onReady" },
          { "type": "triggers.button" },
          { "type": "triggers.timer" },
          { "type": "triggers.onExit" },
          { "type": "triggers.javascript" },
          { "type": "showTo" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.amo" },
          { "type": "integrations.b24" },
          { "type": "integrations.webhook" },
          { "type": "integrations.sheets" },
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [
          { "type": "installation.cloud" },
          { "type": "installation.website" },
          { "type": "installation.telegram" }
        ]
      ]
    }
  ]
}
