            { "type": "textinput", "label": "Название истории", "destination": "settings.stories.4.name", "validator": { "maxLength": 12 } },
            { "type": "textinput", "label": "Заголовок", "destination": "settings.stories.4.title", "validator": { "maxLength": 40 } },
            { "type": "textinput", "label": "Подзаголовок", "destination": "settings.stories.4.subtitle", "size": 2, "validator": { "maxLength": 120 } }
          ]
        },
        {
          "header": "История 6",
          "blocks": [
            { "type": "toggler", "label": "Показывать историю", "destination": "settings.stories.5.enabled" },
            { "type": "textinput", "label": "Ссылка на видео", "destination": "settings.stories.5.videoUrl", "validator": { "maxLength": 500 } },
            { "type": "textinput", "label": "Постер (ссылка на изображение)", "destination": "settings.stories.5.poster", "validator": { "maxLength": 500 } },
            { "type": "imagepicker", "label": "Иконка", "destination": "settings.stories.5.icon", "imageType": "icon", "buttonText": "Выбрать иконку", "modalTitle": "Иконка истории" },
            { "type": "textinput", "label": "Название истории", "destination": "settings.stories.5.name", "validator": { "maxLength": 12 } },
            { "type": "textinput", "label": "Заголовок", "destination": "settings.stories.5.title", "validator": { "maxLength": 40 } },
            { "type": "textinput", "label": "Подзаголовок", "destination": "settings.stories.5.subtitle", "size": 2, "validator": { "maxLength": 120 } }
          ]
        }
      ]
    },
    {
      "id": "settings",
      "header": "Настройки",
      "icon": "settings",
      "blocks": [
        {
          "header": "Кнопка",
          "blocks": [
            { "type": "textinput", "label": "Текст кнопки", "destination": "settings.button.text", "validator": { "maxLength": 30 } },
            { "type": "textinput", "label": "Ссылка в кнопке", "destination": "settings.button.link", "validator": { "maxLength": 200 } }
          ]
        },
        [
          { "type": "toggler", "label": "Выцветание по краям ленты", "destination": "settings.playback.edgeFade" }
        ],
        {
          "header": "Расположение",
          "blocks": [
            {
              "type": "settings.sizeposition",
              "destination": "settings.layout",
              "positions": ["top", "bottom"],
              "features": { "showWidth": false, "showLayoutMode": false, "showOffset": true }
            }
          ]
        }
      ]
    },
    {
      "id": "triggers",
      "header": "Триггеры",
      "icon": "lightning",
      "blocks": [
        [
          { "type": "showTo" },
          { "type": "triggers.onReady" },
          { "type": "triggers.timer" }
        ]
      ]
    },
    {
      "id": "integrations",
      "header": "Интеграции",
      "icon": "code",
      "blocks": [
        [
          { "type": "integrations.metrika" }
        ]
      ]
    },
    {
      "id": "installation",
      "header": "Установка",
      "icon": "play-square",
      "blocks": [
        [
          { "type": "installation.website" }
        ]
      ]
    }
  ]
}
