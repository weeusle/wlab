            { "type": "textinput", "label": "Подзаголовок", "destination": "settings.stories.2.subtitle", "size": 2, "validator": { "maxLength": 120 } }
          ]
        },
        {
          "header": "История 4",
          "blocks": [
            { "type": "toggler", "label": "Показывать историю", "destination": "settings.stories.3.enabled" },
            { "type": "textinput", "label": "Ссылка на видео", "destination": "settings.stories.3.videoUrl", "validator": { "maxLength": 500 } },
