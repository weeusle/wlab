{
  "steps": [
    {
      "id": "design",
      "header": "Дизайн",
      "icon": "palette",
      "block": { "type": "design" }
    },
    {
      "id": "stories",
      "header": "Истории",
      "icon": "image",
      "blocks": [
        {
          "header": "История 1",
          "blocks": [
            { "type": "toggler", "label": "Показывать историю", "destination": "settings.stories.0.enabled" },
            { "type": "textinput", "label": "Ссылка на видео", "destination": "settings.stories.0.videoUrl", "validator": { "maxLength": 500 } },
            { "type": "textinput", "label": "Постер (ссылка на изображение)", "destination": "settings.stories.0.poster", "validator": { "maxLength": 500 } },
            { "type": "imagepicker", "label": "Иконка", "destination": "settings.stories.0.icon", "imageType": "icon", "buttonText": "Выбрать иконку", "modalTitle": "Иконка истории" },
            { "type": "textinput", "label": "Название истории", "destination": "settings.stories.0.name", "validator": { "maxLength": 12 } },
            { "type": "textinput", "label": "Заголовок", "destination": "settings.stories.0.title", "validator": { "maxLength": 40 } },
            { "type": "textinput", "label": "Подзаголовок", "destination": "settings.stories.0.subtitle", "size": 2, "validator": { "maxLength": 120 } }
          ]
        },
        {
          "header": "История 2",
          "blocks": [
            { "type": "toggler", "label": "Показывать историю", "destination": "settings.stories.1.enabled" },
