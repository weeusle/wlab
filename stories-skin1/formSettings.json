            { "type": "imagepicker", "label": "Иконка", "destination": "settings.stories.1.icon", "imageType": "icon", "buttonText": "Выбрать иконку", "modalTitle": "Иконка истории" },
            { "type": "textinput", "label": "Название истории", "destination": "settings.stories.1.name", "validator": { "maxLength": 12 } },
            { "type": "textinput", "label": "Заголовок", "destination": "settings.stories.1.title", "validator": { "maxLength": 40 } },
            { "type": "textinput", "label": "Подзаголовок", "destination": "settings.stories.1.subtitle", "size": 2, "validator": { "maxLength": 120 } }
          ]
