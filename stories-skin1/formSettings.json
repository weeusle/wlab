            { "type": "textinput", "label": "Название истории", "destination": "settings.stories.3.name", "validator": { "maxLength": 12 } },
            { "type": "textinput", "label": "Заголовок", "destination": "settings.stories.3.title", "validator": { "maxLength": 40 } },
            { "type": "textinput", "label": "Подзаголовок", "destination": "settings.stories.3.subtitle", "size": 2, "validator": { "maxLength": 120 } }
          ]
